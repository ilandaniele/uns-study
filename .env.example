# Web: copy to apps/web/.env.local. API: the same names go in apps/api/.dev.vars (see apps/api/.dev.vars.example),
# which `wrangler dev` reads; in production they are Worker vars (wrangler.jsonc) and secrets (`wrangler secret put`).
# Do not commit real secrets.

# ---- Web (apps/web) ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Local dev: talk to the API directly. In production, leave this EMPTY so the web app uses
# same-origin relative URLs (the zone routes /api/* to the API Worker) — that keeps the Better Auth
# session cookie first-party, which Safari/iOS require.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
# Server-only (not exposed to the browser). Local dev only, if the web should proxy /api/auth/* and
# /api/v1/* to the API (apps/web/next.config.ts). Leave empty in production: Cloudflare routes /api/*.
API_PROXY_TARGET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_COMMUNITY_FEED=
NEXT_PUBLIC_ADSENSE_SLOT_RAIL=
# Google Ad Manager full ad unit paths (e.g. /1234567/sala_rewarded). Empty = house ads only.
NEXT_PUBLIC_GAM_REWARDED_UNIT=
NEXT_PUBLIC_GAM_INTERSTITIAL_UNIT=
NEXT_PUBLIC_GA_ID=

# ---- API (apps/api) ----
NODE_ENV=development

# Comma-separated allowed web origins (CSRF, CORS, WebSocket Origin check).
WEB_ORIGINS=http://localhost:3000

# No database URL: the database is SQLite inside the Durable Object (local state under apps/api/.wrangler).

# Salt used to hash client IPs before storing them (security events). Required in production.
IP_HASH_SALT=

BETTER_AUTH_SECRET=
# Local dev: the API's own URL. Behind the web app's proxy (production), set this to the WEB
# origin instead (e.g. https://saladeestudio.com.ar) so cookies/OAuth callbacks use that domain.
BETTER_AUTH_URL=http://localhost:4000

# Set to true to restore cross-site `SameSite=None; Secure` cookies (web/API on different domains,
# no same-origin routing). Leave false in production (same origin).
CROSS_SITE_COOKIES=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated list of emails granted the ADMIN role on their first `/me` request.
ADMIN_EMAILS=

# The one verified account allowed to grant/revoke ADMIN from the admin users tab.
OWNER_EMAIL=ilan.daniele@gmail.com

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

TURNSTILE_SECRET_KEY=

# Absolute public web URL used in email links and the Mercado Pago back_url. Empty = first WEB_ORIGIN.
PUBLIC_WEB_URL=
# Mercado Pago subscriptions. Empty MP_ACCESS_TOKEN = feature disabled.
MP_ACCESS_TOKEN=
# Webhook signing secret from the MP dashboard. Empty = webhook disabled.
MP_WEBHOOK_SECRET=
SUBSCRIPTION_PRICE_ARS=1500
# Resend email campaigns. Empty RESEND_API_KEY or EMAIL_FROM = feature disabled.
RESEND_API_KEY=
EMAIL_FROM=

# Seat photo verification. See docs/SEAT_PHOTO_VERIFIER.md. A model key runs the verifier inside the API Worker.
# With no key the feature is off (the web hides the photo button).
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# VERIFIER_MODEL=
# SEAT_VERIFIER_MIN_CONFIDENCE=0.8
# Dev/test only, ignored when NODE_ENV=production — accepts every photo as the claimed seat.
# SEAT_VERIFIER_MODE=mock

# Dev-only: bypass server-side geofence validation (rejected when NODE_ENV=production).
PRESENCE_DEV_BYPASS=false
# Max age (seconds) of a client-reported location fix before it is considered stale.
PRESENCE_MAX_AGE_S=120
# Max acceptable GPS accuracy radius (meters) for a location fix.
PRESENCE_MAX_ACCURACY_M=150
