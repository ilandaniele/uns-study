# Copy to .env (root, for local db scripts) and/or apps/web/.env.local, apps/api/.env
# Do not commit real secrets.

# ---- Web (apps/web) ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Local dev: talk to the API directly. In production, leave this EMPTY so the web app uses
# same-origin relative URLs, proxied to the API via API_PROXY_TARGET below (see next.config.ts) —
# that keeps the Better Auth session cookie first-party, which Safari/iOS require.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
# Server-only (not exposed to the browser). Production only: the API's own origin (e.g. the Render
# URL). When set, apps/web/next.config.ts rewrites /api/auth/* and /api/v1/* to it.
API_PROXY_TARGET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_ROOM_BOTTOM=
NEXT_PUBLIC_ADSENSE_SLOT_COMMUNITY_FEED=
NEXT_PUBLIC_ADSENSE_SLOT_RAIL=
# Google Ad Manager full ad unit paths (e.g. /1234567/sala_rewarded). Empty = house ads only.
NEXT_PUBLIC_GAM_REWARDED_UNIT=
NEXT_PUBLIC_GAM_INTERSTITIAL_UNIT=
NEXT_PUBLIC_GA_ID=

# ---- API (apps/api) ----
NODE_ENV=development
PORT=4000

WEB_ORIGIN=http://localhost:3000

# Leave empty to use local PGlite storage instead of Postgres.
DATABASE_URL=

# Run pending migrations automatically on API boot. Defaults to true outside production.
DB_AUTO_MIGRATE=

# Salt used to hash client IPs before storing them (security events). Required in production.
IP_HASH_SALT=

BETTER_AUTH_SECRET=
# Local dev: the API's own URL. Behind the web app's proxy (production), set this to the WEB
# origin instead (e.g. https://sala-de-estudio.fly.dev) so cookies/OAuth callbacks use that domain.
BETTER_AUTH_URL=http://localhost:4000

# Reverse-proxy hops in front of the API (Express `trust proxy`). 1 for a single proxy (Railway),
# 2 for the web app's rewrite proxy fronting the API.
TRUST_PROXY_HOPS=1
# Set to true to restore cross-site `SameSite=None; Secure` cookies (web/API on different domains,
# no same-origin proxy). Leave false when using API_PROXY_TARGET.
CROSS_SITE_COOKIES=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Rate limiting: Upstash Redis (REST) takes priority when set; otherwise falls back to a standard
# Redis server via REDIS_URL; otherwise falls back to Postgres in production (rate_limit_hits table
# — no extra setup needed since DATABASE_URL is already required there); otherwise (dev/test only)
# an in-process fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=

# Comma-separated list of emails granted the ADMIN role on their first `/me` request.
ADMIN_EMAILS=

# The one verified account allowed to grant/revoke ADMIN from the admin users tab.
OWNER_EMAIL=ilan.daniele@gmail.com

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_REPORT_EVIDENCE=
R2_ENDPOINT=

TURNSTILE_SECRET_KEY=

# Absolute public web URL used in email links and the Mercado Pago back_url. Empty = first WEB_ORIGIN.
PUBLIC_WEB_URL=
# Mercado Pago subscriptions. Empty MP_ACCESS_TOKEN = feature disabled.
MP_ACCESS_TOKEN=
# Webhook signing secret from the MP dashboard. Empty = webhook disabled.
MP_WEBHOOK_SECRET=
SUBSCRIPTION_PRICE_ARS=1500
# Resend email campaigns. Empty RESEND_API_KEY or EMAIL_FROM = feature disabled.
RESEND_API_KEY=
EMAIL_FROM=

# Seat photo verification (optional external model). See docs/SEAT_PHOTO_VERIFIER.md.
# Unset SEAT_VERIFIER_URL disables the feature entirely (the web hides the photo button).
# SEAT_VERIFIER_URL=
# SEAT_VERIFIER_TOKEN=
# SEAT_VERIFIER_MIN_CONFIDENCE=0.8
# Dev/test only, ignored when NODE_ENV=production — accepts every photo as the claimed seat.
# SEAT_VERIFIER_MODE=mock

# Local PGlite data directory (used when DATABASE_URL is empty). Defaults to <repo>/.data/pglite.
PGLITE_DIR=

# Dev-only: bypass server-side geofence validation (rejected when NODE_ENV=production).
PRESENCE_DEV_BYPASS=false
# Max age (seconds) of a client-reported location fix before it is considered stale.
PRESENCE_MAX_AGE_S=120
# Max acceptable GPS accuracy radius (meters) for a location fix.
PRESENCE_MAX_ACCURACY_M=150
