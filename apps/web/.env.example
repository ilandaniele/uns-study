# Base URL of the NestJS API (REST + Better Auth), no trailing slash.
# Local dev: point straight at the API. Production: leave EMPTY so the web app uses same-origin
# relative URLs (proxied to the API via API_PROXY_TARGET below) — required for the Better Auth
# session cookie to be first-party, which Safari/iOS otherwise block.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Base URL of the Socket.IO server (the API host). Socket.IO always connects directly here — it
# can't go through the API_PROXY_TARGET rewrites — and authenticates via a short-lived token
# fetched from /api/v1/realtime/token instead of the session cookie.
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Server-only (never sent to the browser). Production only: set to the API's own origin (e.g. the
# Render URL) to enable the same-origin proxy in next.config.ts.
API_PROXY_TARGET=

# Cloudflare Turnstile site key (public). Leave empty to skip the widget and show a plain message instead.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Google AdSense publisher id (public, e.g. ca-pub-XXXXXXXXXXXXXXXX). Leave empty to render no ad slots at all.
NEXT_PUBLIC_ADSENSE_CLIENT=
# Ad unit slot ids (public) for each placement. Only used when NEXT_PUBLIC_ADSENSE_CLIENT is set.
NEXT_PUBLIC_ADSENSE_SLOT_ROOM_BOTTOM=
NEXT_PUBLIC_ADSENSE_SLOT_COMMUNITY_FEED=

# Google Analytics 4 measurement id (public). Leave empty to skip loading GA entirely.
NEXT_PUBLIC_GA_ID=
