# Base URL of the API (REST + Better Auth), no trailing slash.
# Local dev: point straight at the API (wrangler dev on port 4000). Production: leave EMPTY so the web
# app uses same-origin relative URLs (Cloudflare routes /api/* to the API Worker); required for the
# Better Auth session cookie to be first-party, which Safari/iOS otherwise block.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Dev only. WebSocket base of the realtime endpoint (ws:// or http://, converted to ws). Leave unset
# in production: the browser then connects to the page's own origin.
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Dev only, server-only (never sent to the browser). Set to the local API origin to serve /api/auth and
# /api/v1 through next.config.ts rewrites on the web origin (what the E2E suite does).
API_PROXY_TARGET=

# Cloudflare Turnstile site key (public). Leave empty to skip the widget and show a plain message instead.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Google AdSense publisher id (public, e.g. ca-pub-XXXXXXXXXXXXXXXX). Leave empty to render no ad slots at all.
NEXT_PUBLIC_ADSENSE_CLIENT=
# Ad unit slot ids (public) for each placement. Only used when NEXT_PUBLIC_ADSENSE_CLIENT is set.
NEXT_PUBLIC_ADSENSE_SLOT_COMMUNITY_FEED=
NEXT_PUBLIC_ADSENSE_SLOT_ROOM_BOTTOM=
# 160x600 slot id for the side rails shown on very wide screens. Empty = house ad in the rails.
NEXT_PUBLIC_ADSENSE_SLOT_RAIL=

# Google Ad Manager ad unit paths (public, e.g. /1234567/sala_rewarded). Empty = house ads only.
NEXT_PUBLIC_GAM_REWARDED_UNIT=
NEXT_PUBLIC_GAM_INTERSTITIAL_UNIT=

# Google Analytics 4 measurement id (public). Leave empty to skip loading GA entirely.
NEXT_PUBLIC_GA_ID=
