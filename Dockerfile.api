# syntax=docker/dockerfile:1
#
# Builds @sala/api for Fly.io. Multi-stage so the final image only carries what
# `node apps/api/dist/main.js` and the migrate/seed scripts (`pnpm db:migrate`, `pnpm db:seed`,
# both `tsx`-run TypeScript against `packages/database`) need at runtime.
#
# NOTE: `apps/web`'s `package.json` is kept in the build context (see `.dockerignore`) purely so
# `pnpm install --frozen-lockfile` sees every workspace importer the lockfile expects; its source,
# `node_modules` and build output are not needed to build/run the API and are excluded. This does
# mean the shared `node_modules` installed below includes apps/web's dependencies too — heavier
# than a fully pruned image (e.g. via `turbo prune`), but simple and correct; revisit if image size
# becomes a problem.

FROM node:22-slim AS base
RUN corepack enable
WORKDIR /app

# ---- deps: install the full workspace (frozen lockfile) ----
FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY apps/verifier/package.json apps/verifier/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/database/package.json packages/database/package.json
RUN pnpm install --frozen-lockfile

# ---- build: compile @sala/api (tsup bundles @sala/contracts + @sala/database sources in) ----
FROM deps AS build
COPY . .
RUN pnpm --filter @sala/api build

# ---- runtime ----
FROM base AS runtime
ENV NODE_ENV=production

# pnpm (shamefully-hoist=false) keeps each package's deps as symlinks in that package's own
# node_modules, pointing into the root node_modules/.pnpm store: both levels must ship.
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/package.json ./package.json
COPY --from=deps /app/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY --from=deps /app/packages/database/package.json ./packages/database/package.json
COPY --from=deps /app/packages/database/node_modules ./packages/database/node_modules
COPY --from=deps /app/apps/api/package.json ./apps/api/package.json
COPY --from=deps /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=build /app/apps/api/dist ./apps/api/dist
# Migrations + seed run inside the bundled API (main.ts, BOOT_MIGRATE_SEED=true), so only the SQL
# migrations need to ship (resolved from the repo root via pnpm-workspace.yaml, copied above).
COPY packages/database/migrations ./packages/database/migrations

# Official Node images ship a non-root `node` user (uid 1000) — use it instead of provisioning one.
USER node

EXPOSE 8080

CMD ["node", "apps/api/dist/main.js"]
