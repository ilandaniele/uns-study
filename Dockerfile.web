# syntax=docker/dockerfile:1
#
# Builds @sala/web (Next.js standalone output) for Fly.io. The API host is baked in at build time:
# next.config.ts turns API_PROXY_TARGET into the /api rewrites and NEXT_PUBLIC_SOCKET_URL.

FROM node:22-slim AS base
RUN corepack enable
WORKDIR /app

# ---- deps: install the full workspace (frozen lockfile) ----
FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY apps/verifier/package.json apps/verifier/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/database/package.json packages/database/package.json
RUN pnpm install --frozen-lockfile

# ---- build ----
FROM deps AS build
ARG API_PROXY_TARGET
ARG NEXT_PUBLIC_GAM_REWARDED_UNIT
ARG NEXT_PUBLIC_GAM_INTERSTITIAL_UNIT
ARG NEXT_PUBLIC_ADSENSE_CLIENT
ARG NEXT_PUBLIC_ADSENSE_SLOT_RAIL
ENV API_PROXY_TARGET=$API_PROXY_TARGET \
    NEXT_PUBLIC_GAM_REWARDED_UNIT=$NEXT_PUBLIC_GAM_REWARDED_UNIT \
    NEXT_PUBLIC_GAM_INTERSTITIAL_UNIT=$NEXT_PUBLIC_GAM_INTERSTITIAL_UNIT \
    NEXT_PUBLIC_ADSENSE_CLIENT=$NEXT_PUBLIC_ADSENSE_CLIENT \
    NEXT_PUBLIC_ADSENSE_SLOT_RAIL=$NEXT_PUBLIC_ADSENSE_SLOT_RAIL \
    NEXT_OUTPUT_STANDALONE=1 \
    NEXT_TELEMETRY_DISABLED=1
COPY . .
RUN pnpm --filter @sala/web build

# ---- runtime ----
FROM node:22-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=8080 \
    HOSTNAME=0.0.0.0
COPY --from=build /app/apps/web/.next/standalone ./
COPY --from=build /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /app/apps/web/public ./apps/web/public
USER node
EXPOSE 8080
CMD ["node", "apps/web/server.js"]
