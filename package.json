{
  "name": "sala-de-estudio",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @sala/database db:generate",
    "db:migrate": "pnpm --filter @sala/database db:migrate",
    "db:seed": "pnpm --filter @sala/database db:seed",
    "load:smoke": "k6 run tests/load/scenarios/smoke.js",
    "load:load": "k6 run tests/load/scenarios/load.js",
    "load:stress": "k6 run tests/load/scenarios/stress.js",
    "load:spike": "k6 run tests/load/scenarios/spike.js",
    "load:soak": "k6 run tests/load/scenarios/soak.js",
    "load:peak": "k6 run tests/load/scenarios/peak.js"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "turbo": "^2.11.7",
    "typescript": "^5.7.2",
    "typescript-eslint": "~8.70.1"
  },
  "pnpm": {
    "overrides": {
      "multer": "^2.3.0",
      "qs": "^6.16.0",
      "body-parser@1": "^1.20.6",
      "file-type": "^21.3.2",
      "uuid@11": "^11.1.1",
      "source-map-js": "^1.2.2",
      "sharp": "^0.35.5",
      "typescript-eslint": "$typescript-eslint"
    }
  }
}
