{
  "name": "sala-de-estudio",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "legal:check": "node --test scripts/legal/source-policy.test.mjs",
    "db:generate": "pnpm --filter @sala/database db:generate",
    "load:smoke": "k6 run tests/load/scenarios/smoke.js",
    "load:load": "k6 run tests/load/scenarios/load.js",
    "load:stress": "k6 run tests/load/scenarios/stress.js",
    "load:spike": "k6 run tests/load/scenarios/spike.js",
    "load:soak": "k6 run tests/load/scenarios/soak.js",
    "load:peak": "k6 run tests/load/scenarios/peak.js"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "turbo": "^2.11.7",
    "typescript": "^5.7.2",
    "typescript-eslint": "~8.71.1"
  },
  "pnpm": {
    "overrides": {
      "qs": "^6.16.0",
      "body-parser@1": "^1.20.6",
      "body-parser@2": "^2.4.0",
      "undici@6": "^6.29.1",
      "undici@7": "^7.30.1",
      "esbuild@<0.25.0": "^0.25.0",
      "zod": "^4.6.6",
      "file-type": "^21.3.2",
      "uuid@11": "^11.1.1",
      "glob@10": "^10.5.0",
      "source-map-js": "^1.2.2",
      "sharp": "^0.35.5",
      "typescript-eslint": "$typescript-eslint",
      "vite@7": "^7.3.7"
    },
    "patchedDependencies": {
      "@opennextjs/cloudflare@1.20.11": "patches/@opennextjs__cloudflare@1.20.11.patch"
    }
  }
}
