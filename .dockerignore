node_modules
.next
.data
.git
.turbo
coverage
test-results
playwright-report
reference-images

# Keep apps/web's package.json (needed so `pnpm install --frozen-lockfile` sees every workspace
# importer the lockfile expects) but drop everything else — source, node_modules, .next, etc.
apps/web/*
!apps/web/package.json

# Docs — not needed to build/run the API. Keep root README (referenced by `pnpm install`/tooling
# output) and anything under docs/ that isn't purely narrative isn't excluded here either way.
*.md
!README.md
